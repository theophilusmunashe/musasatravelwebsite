# Public (safe to commit). Copy values into `.env` / `.env.local`.
# Never put SANITY_API_TOKEN in `.env` if that file is committed — use `.env.local`.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-31
NEXT_PUBLIC_BASE_URL=https://www.musasatravelandtours.com

